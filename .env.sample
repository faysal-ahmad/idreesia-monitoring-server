# Environment for the production compose files (docker-compose.production.yml and
# docker-compose.production-local.yml). Copy to .env next to them and fill in the values.
# docker-compose.development.yml sets its own values inline and doesn't read this file.

# --- Postgres (read by the postgres container on first start) ---
POSTGRES_DB=idreesia
POSTGRES_USER=idreesia
POSTGRES_PASSWORD=change-me

# --- Host folders (substituted by docker compose into the volume mounts) ---
# Postgres data directory on the host
POSTGRES_DATA_HOST_DIR=/data/postgres/data
# Alert frame images on the host; must be writable by UID 1001 (the security server's user)
ALERT_IMAGES_HOST_DIR=/data/alert-images

# --- Security server ---
# Must match the POSTGRES_* values above. sslmode=disable: the postgres container has no TLS, and
# Prisma otherwise attempts (and fails) a TLS handshake.
DATABASE_URL=postgresql://idreesia:change-me@postgres:5432/idreesia?schema=security_server&sslmode=disable
# Password for the admin pages (everything except Alerts). Admin pages are inaccessible while unset.
ADMIN_PASSWORD=change-me
# Read RTSP over TCP in OpenCV's FFmpeg backend; over UDP, lost RTP packets make reads silently
# return empty frames.
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp
# cuda runs the face models on the GPU (needs the CUDA image from docker-compose.production.yml and
# the NVIDIA Container Toolkit on the host). Leave empty to run them on the CPU.
OPENCV_DNN_TARGET=cuda

# --- ERP (owns channels and profiles, receives alerts) ---
# ERP service account with the "Sync Security Server Data" permission. Syncing is off unless all
# three are set.
ERP_URL=https://erp.example.com
ERP_USERNAME=security-server
ERP_PASSWORD=change-me

# --- Optional; the defaults match the compose files ---
# PORT=3000
# ALERT_IMAGES_DIR=/data/alert-images
# MEDIA_SERVER_API_URL=http://go2rtc:1984
# MEDIA_SERVER_RTSP_URL=rtsp://go2rtc:8554

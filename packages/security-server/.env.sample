# PostgreSQL (matches docker-compose.development.yml's postgres service)
DATABASE_URL="postgresql://idreesia:idreesia@postgres:5432/idreesia?schema=security_server"
# Where alert frame images are stored (optional; defaults to /data/alert-images, which both
# docker-compose files mount — a volume in development, a host folder in production).
# ALERT_IMAGES_DIR="/data/alert-images"

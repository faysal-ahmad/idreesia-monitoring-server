{
  "name": "@idreesia/security-server",
  "version": "0.1.0",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "env": {
            "NODE_ENV": "production"
          },
          "cwd": "packages/security-server"
        },
        "configurations": {
          "development": {
            "env": {
              "NODE_ENV": "development"
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/packages/security-server/dist/package.json",
          "{workspaceRoot}/packages/security-server/dist/yarn.lock"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/packages/security-server/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@idreesia/security-server:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@idreesia/security-server:build:development"
          },
          "production": {
            "buildTarget": "@idreesia/security-server:build:production"
          }
        }
      },
      "prisma-generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma generate --schema=packages/security-server/prisma/schema.prisma",
          "cwd": "."
        }
      },
      "prisma-migrate-dev": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma migrate dev --schema=packages/security-server/prisma/schema.prisma",
          "cwd": "."
        }
      },
      "prisma-migrate-deploy": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma migrate deploy --schema=packages/security-server/prisma/schema.prisma",
          "cwd": "."
        }
      },
      "prisma-studio": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma studio --schema=packages/security-server/prisma/schema.prisma",
          "cwd": "."
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^6",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  }
}

FROM node:24.22.1-bookworm-slim AS build

WORKDIR /app

COPY . .

# Yarn 1 installs every workspace's dependencies, including the security-server's
# native @u4/opencv4nodejs. --ignore-scripts skips its node-gyp build (the UI never
# loads it), so this stage needs no OpenCV or compiler toolchain. The UI's own
# native tooling (swc, rolldown, parcel watcher, nx) ships prebuilt binaries as
# optional dependencies, so it doesn't rely on install scripts.
RUN yarn install --frozen-lockfile --ignore-scripts
RUN yarn nx run @idreesia/security-server-ui:build

FROM nginx:1.27-alpine AS production

COPY --from=build /app/packages/security-server-ui/dist /usr/share/nginx/html
COPY packages/security-server-ui/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 4200

HEALTHCHECK --start-period=10s --interval=10s --timeout=5s --retries=10 \
  CMD wget -q -O- http://127.0.0.1:4200 || exit 1

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector(schema: "security_server")]
  schemas    = ["security_server"]
}

// A configured RTSP camera ("channel") the recognition engine reads frames from. Connection
// details (host, port, path, credentials) live in `config` (validated by RtspConfigSchema).
model VideoFeedSource {
  id                  String              @id @default(cuid())
  name                String
  config              Json
  enabled             Boolean             @default(true)
  // null = use SFace's hardcoded reference default; set via the per-channel test-match calibration flow.
  similarityThreshold Float?
  // How many frames per second are analyzed for faces. All frames are still read to keep the
  // stream near-live — this only limits how many reach recognition.
  recognitionFps      Float               @default(5)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  alerts Alert[]

  @@schema("security_server")
}

// A watch-list person. isTest separates calibration profiles from real monitoring profiles;
// test profiles are excluded from the live alert pipeline's match set unless
// Configuration.includeTestProfilesInAlerts is on.
model MonitoringProfile {
  id        String   @id @default(cuid())
  name      String
  isTest    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images MonitoringProfileImage[]
  alerts Alert[]

  @@schema("security_server")
}

// One enrollment photo for a MonitoringProfile, with its own SFace embedding
// computed at upload time (embeddings are not aggregated per person).
model MonitoringProfileImage {
  id                    String                     @id @default(cuid())
  profileId             String
  profile               MonitoringProfile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  image                 Bytes
  // 128-d SFace embedding. Prisma has no native vector type support, so reads/
  // writes to this column go through $queryRaw/$executeRaw.
  embedding             Unsupported("vector(128)")
  // The pipeline version that produced `embedding` (see EMBEDDING_MODEL_VERSION). Embeddings from
  // different versions aren't comparable; anything not on the current version is recomputed from
  // `image` at startup by EmbeddingBackfillService. null = produced before versioning existed.
  embeddingModelVersion String?
  createdAt             DateTime                   @default(now())

  @@schema("security_server")
}

// Detection history: who was detected, when, by which channel, on what evidence, and how
// confident the match was.
model Alert {
  id                  String            @id @default(cuid())
  timestamp           DateTime          @default(now())
  monitoringProfileId String
  // Deleting a monitoring profile wipes its alert history.
  monitoringProfile   MonitoringProfile @relation(fields: [monitoringProfileId], references: [id], onDelete: Cascade)
  channelId           String
  // Deleting a channel with alert history is blocked (no cascade) to preserve the log.
  channel             VideoFeedSource   @relation(fields: [channelId], references: [id], onDelete: Restrict)
  // File name (<uuid>.jpg) of the downscaled frame that triggered this alert — the visual
  // evidence an admin reviews. The JPEG itself lives on disk under ALERT_IMAGES_DIR, not in the DB.
  imageFile           String
  // Cosine similarity between the detected face and the matched profile's embedding at alert time.
  similarityScore     Float
  // Operator's verdict on the match; null = not reviewed yet. Paired with similarityScore, this is
  // the ground truth for calibrating channel similarity thresholds.
  review              AlertReview?
  reviewedAt          DateTime?

  @@schema("security_server")
}

enum AlertReview {
  CORRECT
  FALSE_POSITIVE

  @@schema("security_server")
}

// App-wide settings — a generic key-value store so new settings can be added without a
// schema migration. `value` is untyped JSON at the DB level; each key's label, default, and
// validation live in CONFIG_DEFINITIONS (src/configuration/configuration.schema.ts).
model Configuration {
  key         String   @id
  displayName String
  value       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("security_server")
}

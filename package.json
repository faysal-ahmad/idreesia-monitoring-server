{
  "name": "@idreesia/security-server",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "compose:development": "docker compose --file docker-compose.development.yml --project-name idreesia-security-server",
    "compose:production": "docker compose --file docker-compose.production.yml --project-name idreesia-security-server",
    "docker:development:up": "yarn compose:development up -d --build",
    "docker:development:down": "yarn compose:development down",
    "docker:development:destroy": "yarn compose:development down --volumes",
    "docker:development:restart": "yarn compose:development up -d --force-recreate",
    "docker:production:build": "yarn compose:production build",
    "docker:production:up": "yarn compose:production up -d",
    "docker:production:down": "yarn compose:production down",
    "docker:production:destroy": "yarn compose:production down --volumes",
    "prisma:generate": "nx run @idreesia/security-server:prisma-generate",
    "prisma:migrate:dev": "nx run @idreesia/security-server:prisma-migrate-dev",
    "prisma:migrate:deploy": "nx run @idreesia/security-server:prisma-migrate-deploy",
    "prisma:studio": "nx run @idreesia/security-server:prisma-studio",
    "prisma:db:seed": "nx run @idreesia/security-server:prisma-db-seed"
  },
  "prisma": {
    "seed": "node -r @swc-node/register packages/security-server/prisma/seed.ts"
  },
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^6",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^6",
    "@tanstack/react-query": "^5",
    "@u4/opencv4nodejs": "^7.1.2",
    "antd": "^6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.30.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "23.1.1",
    "@nx/react": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jiti": "2.4.2",
    "nx": "23.1.1",
    "prettier": "^3.8.1",
    "prisma": "^6",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "workspaces": [
    "packages/*"
  ]
}

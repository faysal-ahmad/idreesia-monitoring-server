FROM node:22.17.0-alpine3.22 AS build

# This is a yarn workspace with a single shared node_modules — @u4/opencv4nodejs
# (a security-server-only dependency) still needs to compile here since `yarn
# install` resolves the whole workspace's tree, not just this package's own deps.
RUN apk --no-cache add \
  opencv-dev \
  build-base \
  g++ \
  python3 \
  pkgconfig
ENV OPENCV4NODEJS_DISABLE_AUTOBUILD=1
ENV OPENCV_INCLUDE_DIR=/usr/include/opencv4
ENV OPENCV_LIB_DIR=/usr/lib
ENV MAKEFLAGS=-j1

WORKDIR /app

COPY . .

RUN yarn install --frozen-lockfile
RUN yarn nx run @idreesia/security-server-ui:build

FROM nginx:1.27-alpine AS production

COPY --from=build /app/packages/security-server-ui/dist /usr/share/nginx/html
COPY packages/security-server-ui/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 4200

HEALTHCHECK --start-period=10s --interval=10s --timeout=5s --retries=10 \
  CMD wget -q -O- http://127.0.0.1:4200 || exit 1

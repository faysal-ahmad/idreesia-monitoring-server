FROM node:22.23.4-bookworm-slim

# Both dev containers share the repo's .nx cache/lock state via the bind mount below —
# a persistent daemon from one container gets confused by the other's runs (false
# "recursive task invocation" errors), so each container runs Nx as a one-shot process.
ENV NX_DAEMON=false

WORKDIR /app

EXPOSE 4200

# bookworm-slim has no wget/curl, so probe with Node's built-in fetch
HEALTHCHECK --start-period=30s --interval=10s --timeout=5s --retries=20 \
  CMD node -e "fetch('http://127.0.0.1:4200').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"

# Yarn 1 installs every workspace's dependencies, including the security-server's
# native @u4/opencv4nodejs. --ignore-scripts skips its node-gyp build (the UI never
# loads it), so this image needs no OpenCV or compiler toolchain. The UI's own
# native tooling (swc, rolldown, parcel watcher, nx) ships prebuilt binaries as
# optional dependencies, so it doesn't rely on install scripts.
CMD yarn install --ignore-scripts && \
  yarn nx run @idreesia/security-server-ui:serve --host 0.0.0.0 --port 4200
